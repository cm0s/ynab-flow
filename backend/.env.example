YNAB_API_KEY=
# Local SQLite is the default. Hosted: Supabase session-pooler URL, with sslmode=require.
# DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
# For hosted auth, all three values are required:
# AUTH_REQUIRED=true
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# ADMIN_USER_ID=your-supabase-auth-user-uuid
# Only for legacy HS256 signing keys:
# SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173
