YNAB_API_KEY=
# Local SQLite is the default. Hosted: Supabase session-pooler URL, with sslmode=require.
# DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
# For hosted auth, all three values are required:
# AUTH_REQUIRED=true
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# ADMIN_USER_ID=your-supabase-auth-user-uuid
# Only for legacy HS256 signing keys:
# SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173

# --- Receipts from Proton Mail Bridge (optional; off when unset) ---
# Bridge runs locally; use the Bridge-generated password, not your Proton password.
# BRIDGE_IMAP_HOST=127.0.0.1
# BRIDGE_IMAP_PORT=1143
# Exported Bridge certificate. Without it, TLS is unverified and allowed only on 127.0.0.1/localhost.
# BRIDGE_CERT_PATH=/path/to/bridge-cert.pem
# BRIDGE_MAILBOXES=me,partner
# BRIDGE_ME_USER=me@proton.me
# BRIDGE_ME_PASSWORD=
# BRIDGE_PARTNER_USER=partner@proton.me
# BRIDGE_PARTNER_PASSWORD=
# Comma-separated folders/labels to read (read-only)
# BRIDGE_FOLDERS=INBOX

# --- AI suggestions with Claude (optional; off without a key) ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# Model for reading receipts; defaults to AI_MODEL
# AI_EXTRACTION_MODEL=
# Hard monthly cap in USD; requests stop once this month's recorded cost reaches it
# AI_MONTHLY_BUDGET_USD=10
# AI_MAX_CONCURRENCY=4
